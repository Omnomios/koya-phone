# Koya phone shell; syntax for Hyprland 0.51.x.
# Installed by install.sh. Edit the installed copy to tune.
monitor = , preferred, auto, 2
workspace = 1, persistent:true
exec-once = exec @SHELL_COMMAND@

general {
    gaps_in = 0
    gaps_out = 0
    border_size = 0
    layout = dwindle
}
decoration {
    rounding = 0
    blur {
        enabled = false
    }
    shadow {
        enabled = false
    }
}
animations {
    enabled = true
    bezier = koya, 0.22, 1, 0.36, 1
    animation = windows, 1, 3, koya, popin 96%
    animation = fade, 1, 2, koya
    animation = workspaces, 1, 3, koya, slide
    animation = borderangle, 0
    animation = fadeDpms, 0
}
# Koya animates its own layers; compositor transitions apply to applications.
layerrule = noanim, ^koya-.*$
# Maximize into the usable area, keeping the top bar visible.
windowrule = fullscreenstate 1 0, class:.*

input {
    touchdevice {
        enabled = true
        transform = -1
    }
}
cursor {
    hide_on_touch = true
    no_warps = true
}
misc {
    initial_workspace_tracking = 2
    disable_hyprland_qtutils_check = true
    enable_anr_dialog = false
    disable_hyprland_logo = true
    disable_splash_rendering = true
    background_color = rgb(10271e)
    mouse_move_enables_dpms = false
    key_press_enables_dpms = false
}
# Phone-shell interactions belong to Koya.
ecosystem {
    no_update_news = true
    no_donation_nag = true
}
xwayland {
    enabled = false
}
# Optional keyboard controls while testing. Hardware power/volume stay in Koya.
bind = SUPER, Q, killactive,
bind = SUPER, 1, workspace, 1
bind = SUPER, 2, workspace, 2
bind = SUPER, 3, workspace, 3
